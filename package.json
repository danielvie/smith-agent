{
  "name": "smith-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.22.3"
  },
  "type": "module",
  "description": "Windows-first POC for a local assistant agent",
  "scripts": {
    "run": "tsx src/cli.ts",
    "ui": "npm run ui:build && tsx src/cli.ts --ui",
    "test": "npm run ui:build && vitest run",
    "check": "tsc --noEmit",
    "build:windows": "npm run ui:build && node scripts/build-sea.mjs && npm run test:sea",
    "test:sea": "node scripts/verify-sea.mjs",
    "ui:css": "tailwindcss -i src/web/styles.css -o src/web/styles.generated.css --minify",
    "ui:build": "npm run ui:css && node scripts/build-ui.mjs",
    "ui:check": "tsx scripts/verify-tailwind.ts",
    "ui:verify": "npm run ui:build && tsx scripts/verify-ui.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dompurify": "^3.4.14",
    "echarts": "^6.1.0",
    "katex": "^0.18.4",
    "marked": "^18.0.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4",
    "@types/node": "^22.19.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
